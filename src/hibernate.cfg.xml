<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD
3.0//EN" "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
<session-factory>
<property name="connection.driver_class">com.mysql.jdbc.Driver</property>
<property name="connection.url">
jdbc:mysql://localhost/bd-epicentro-gourmet</property>
<property name="connection.username">root</property>
<property name="connection.password">root</property>
<property name="connection.pool_size">1</property>
<property name="dialect">org.hibernate.dialect.MySQL5InnoDBDialect</property>
<property name="show_sql">false</property><!-- en true muestra hql en
consola-->
<property name="hbm2ddl.auto">create</property>
<mapping resource="mapeos/Persona.hbm.xml" />
<mapping resource="mapeos/UnidadDeVenta.hbm.xml" />
<mapping resource="mapeos/Plato.hbm.xml"/>
<mapping resource="mapeos/Pedido.hbm.xml"/>
</session-factory>
</hibernate-configuration>
