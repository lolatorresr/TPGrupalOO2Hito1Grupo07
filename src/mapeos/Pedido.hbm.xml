<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="datos.Pedido" table="pedido">
		
		<id column="idPedido" name="idPedido">
			<generator class="identity" />
		</id>

		<property column="fechaTransaccion" name="fechaTransaccion" type="LocalDate" />
		<!--<many-to-one name="festival" class="datos.Festival" column="idFestival" not-null="true" />-->
		<many-to-one name="unidadVenta" class="datos.UnidadDeVenta" column="idUnidadDeVenta" not-null="true" />

		<set name="itemPlatos" table="itemplato" inverse="false"
			lazy="false" fetch="select" cascade="all-delete-orphan">
		<key column="idPedido" not-null="true" />
		<one-to-many class="datos.ItemPlato" />
		</set>

	</class>
</hibernate-mapping>