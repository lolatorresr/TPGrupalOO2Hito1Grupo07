<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
	<class name="datos.ItemPlato" table="itemplato">
		
		<id column="idItemPlato" name="idItemPlato">
			<generator class="identity" />
		</id>

		<property column="cantidad" name="cantidad" type="int" />
		<property column="subTotal" name="subTotal" type="double" />
		<many-to-one name="plato" class="datos.Plato" column="idPlato" not-null="true" lazy="false" />

	</class>
</hibernate-mapping>
